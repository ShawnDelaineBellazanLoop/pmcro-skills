{
  "max_cycles": 5,
  "max_phase_attempts": 2,
  "max_wall_time_seconds": 1800,
  "max_output_bytes": 10485760,
  "require_approval_for": [
    "destructive_filesystem_operation",
    "production_deployment",
    "secret_access",
    "governance_change",
    "untrusted_script"
  ],
  "allowed_verdicts": ["ACCEPT", "EXTEND", "LOOP", "ESCALATE", "INTERRUPT"],
  "trail_path": ".pmcro/trails/events.jsonl",
  "queue_lease_seconds": 120,
  "max_queue_attempts": 3,
  "max_ingress_bytes": 65536,
  "trusted_ingress_sources": []
}
