{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMCRO ReflectionFrame",
  "type": "object",
  "required": ["cycle_id", "phase", "frames", "earned_constraints", "next_seed"],
  "properties": {
    "cycle_id": {"type": "string"},
    "phase": {"const": "reflector"},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["question", "answer", "phase"], "properties": {"question": {"type": "string"}, "answer": {"type": "string"}, "phase": {"const": "reflector"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "earned_constraints": {"type": "array", "items": {"type": "string"}},
    "next_seed": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
