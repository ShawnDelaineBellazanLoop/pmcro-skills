{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMCRO ToolResult",
  "type": "object",
  "required": ["type", "request_id", "status", "exit_code"],
  "properties": {
    "type": {"const": "ToolResult"},
    "request_id": {"type": "string"},
    "status": {"enum": ["completed", "failed", "denied", "timed-out", "cancelled"]},
    "exit_code": {"type": ["integer", "null"]},
    "stdout_ref": {"type": ["string", "null"]},
    "stderr_ref": {"type": ["string", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "approval_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
